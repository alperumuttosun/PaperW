  fao_sub <- extra_fao_wide[extra_fao_wide$Item %in% cfg$fao, ]
  
  if (nrow(fao_sub) == 0) {
    cat("  [SKIP] No FAO data in extra file for this crop\n")
    writexl::write_xlsx(panelv2, output_path); next
  }
  
  extra_rows <- list()
  
  for (iso in EXTRA_COUNTRIES) {
    if (!iso %in% unique(fao_sub$Country_ISO)) next
    if (is.null(extra_climate_by_crop[[crop_name]][[iso]])) next
    
    country_monthly <- extra_climate_by_crop[[crop_name]][[iso]]
    
    # Annual aggregation for this extra country -- same logic as Step 2
    annual_extra <- country_monthly %>%
      dplyr::arrange(Yil, Ay) %>%
      dplyr::group_by(Country_ISO, Yil) %>%
      dplyr::summarise(
        TMP_ann = mean(TMP, na.rm = TRUE), TMX_ann = mean(TMX, na.rm = TRUE),
        TMN_ann = mean(TMN, na.rm = TRUE), DTR_ann = mean(DTR, na.rm = TRUE),
        CLD_ann = mean(CLD, na.rm = TRUE), VAP_ann = mean(VAP, na.rm = TRUE),
        PRE_ann = sum(PRE,  na.rm = TRUE), PET_ann = sum(PET * days_in_month_of(Yil, Ay), na.rm = TRUE),
        WET_ann = sum(WET,  na.rm = TRUE), FRS_ann = sum(FRS, na.rm = TRUE),
        TempVariance = var(TMP, na.rm = TRUE),
        .groups  = "drop") %>%
      dplyr::mutate(dplyr::across(dplyr::where(is.numeric),
                                  ~ifelse(is.nan(.), NA_real_, .)))
    
    fao_join <- fao_sub[fao_sub$Country_ISO == iso,
                        c("Country_ISO","Year","area_harvested_ha",
                          "production_tonnes","yield_hg_per_ha")]
    annual_extra <- annual_extra %>%
      dplyr::left_join(fao_join, by = c("Country_ISO","Yil" = "Year")) %>%
      dplyr::left_join(co2_df,   by = "Yil") %>%
      dplyr::left_join(gdp_fallback, by = c("Country_ISO","Yil"))
    
    extra_rows[[iso]] <- annual_extra
    cat("  [Annual]", iso, nrow(annual_extra), "rows\n")
  }
  
  if (length(extra_rows) == 0) {
    writexl::write_xlsx(panelv2, output_path); next
  }
  
  extra_df <- dplyr::bind_rows(extra_rows)
  # Apply same filters as Step 2
  extra_df <- extra_df[!is.na(extra_df$production_tonnes), ]
  extra_df <- extra_df[!is.na(extra_df$yield_hg_per_ha) &
                         extra_df$yield_hg_per_ha >= YIELD_THRESHOLD, ]
  year_counts <- extra_df %>%
    dplyr::group_by(Country_ISO) %>%
    dplyr::summarise(n = dplyr::n(), .groups = "drop")
  extra_df <- extra_df[extra_df$Country_ISO %in%
                         year_counts$Country_ISO[year_counts$n >= MIN_YEARS], ]
  
  # Column-align and bind with panelv2
  for (k in setdiff(names(panelv2), names(extra_df))) extra_df[[k]]  <- NA
  for (k in setdiff(names(extra_df), names(panelv2))) panelv2[[k]]   <- NA
  common_cols <- union(names(panelv2), names(extra_df))
  panelv3 <- rbind(panelv2[, common_cols], extra_df[, common_cols])
  panelv3 <- panelv3[order(panelv3$Country_ISO, panelv3$Yil), ]
  rownames(panelv3) <- NULL
  
  cat("  [panelv3]", nrow(panelv3), "rows |",
      length(unique(panelv3$Country_ISO)), "countries\n")
  writexl::write_xlsx(panelv3, output_path)
  cat("  [SAVED]", basename(output_path), "\n")
  rm(panelv2, extra_df, panelv3, extra_rows); gc()
}



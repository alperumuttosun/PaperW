                                   panel_final$Yil, panel_final$Ay), ]
  rownames(panel_final) <- NULL
  
  cat("\n[OK]", crop_name, "- Rows:", nrow(panel_final),
      "| Cols:", ncol(panel_final), "\n")
  
  output_path <- file.path(base_dir, paste0(cfg$p1, ".xlsx"))
  writexl::write_xlsx(panel_final, output_path)
  cat("[SAVED]", output_path, "\n")
}

# ==============================================================================
# CHECK + UPDATE -- yield/area/GDP plausibility, and fixed-baseline weights
#
# PART A (read-only): plausibility checks for
#   - yield_hg_per_ha   (implausible/outlier values, per crop)
#   - area_harvested_ha (implausible values, and cross-check against
#                        cropland_area_1000ha from Step 5 -- a single crop's
#                        harvested area should not routinely exceed a
#                        country's total cropland area)
#   - GDP_per_Capita    (negative/zero, extreme year-over-year jumps, and
#                        any leftover flat/backfilled runs not caught by
#                        Step 7's remove_gdp_backfill())
#
# PART B (MODIFIES panelv7_*.xlsx): adds the fixed-baseline weight columns
# needed for the fixed-baseline weighting specification (weights = 1990-2000
# fixed average production).
#   baseline_production_tonnes   -- fixed weight, same value for every year
#                                   of a given country (does not vary by Yil)
#   baseline_area_harvested_ha   -- same idea, for area-based robustness
#   baseline_period_used         -- text label: "1990-2000" or the actual
#                                   fallback window used (e.g. "1961-1971")
#   baseline_is_fallback         -- 1 if the country had zero years within
#                                   1990-2000 and a fallback window was used
#
# Fallback rule when a country has no data in 1990-2000:
#   Use the country's own earliest available years (first 11, or all
#   available if fewer than 11) as its baseline window instead. This keeps
#   the weight fixed and independent of any later-year climate shocks for
#   that country, just anchored to its actual data start instead of a
#   universal calendar window.
# ==============================================================================

library(dplyr)
library(readxl)
library(writexl)

base_dir   <- "C:/Users/Alper.Tosun/Desktop/cru130"
crop_names <- c("wheat","barley","oats","rye","rice","maize","soybean","sorghum")

read_panel <- function(crop_name) {
  f <- file.path(base_dir, paste0("panelv7_", crop_name, ".xlsx"))
  if (!file.exists(f)) return(NULL)
  as.data.frame(readxl::read_excel(f))
}


# ==============================================================================
# PART A1 -- YIELD PLAUSIBILITY
# ==============================================================================

cat(strrep("=", 70), "\n")
cat("PART A1 -- yield_hg_per_ha plausibility (per crop)\n")
cat(strrep("=", 70), "\n\n")

yield_flags <- list()

for (crop_name in crop_names) {
  df <- read_panel(crop_name)
  if (is.null(df) || !"yield_hg_per_ha" %in% names(df)) next
  
  y <- df$yield_hg_per_ha
  cat(sprintf("[%-8s] min=%.0f  P1=%.0f  median=%.0f  mean=%.0f  P99=%.0f  max=%.0f  (hg/ha)\n",
              crop_name, min(y, na.rm = TRUE), quantile(y, 0.01, na.rm = TRUE),
              median(y, na.rm = TRUE), mean(y, na.rm = TRUE),
              quantile(y, 0.99, na.rm = TRUE), max(y, na.rm = TRUE)))
  
  # Negative/zero shouldn't exist (YIELD_THRESHOLD>=1 already applied), but
  # verify. Also flag extreme statistical outliers within each crop
  # (beyond mean +/- 5 SD) for manual review -- not auto-removed.
  neg_or_zero <- df[!is.na(y) & y <= 0, c("Country_ISO","Yil","yield_hg_per_ha")]
  mu <- mean(y, na.rm = TRUE); sdv <- sd(y, na.rm = TRUE)
  extreme <- df[!is.na(y) & abs(y - mu) > 5 * sdv,
                c("Country_ISO","Yil","yield_hg_per_ha")]
  
  if (nrow(neg_or_zero) > 0) {
    cat(sprintf("  [FLAG] %d rows with yield <= 0\n", nrow(neg_or_zero)))
  }
  if (nrow(extreme) > 0) {
    cat(sprintf("  [FLAG] %d rows beyond mean +/- 5 SD (statistical outliers, for review):\n",
                nrow(extreme)))
    print(head(extreme[order(-extreme$yield_hg_per_ha), ], 10))
    yield_flags[[crop_name]] <- cbind(crop = crop_name, extreme)
  }
  if (nrow(neg_or_zero) == 0 && nrow(extreme) == 0)
    cat("  [OK] no implausible or extreme-outlier yields\n")
  cat("\n")
}
yield_flags_df <- dplyr::bind_rows(yield_flags)


# ==============================================================================
# PART A2 -- AREA_HARVESTED_HA PLAUSIBILITY (incl. cross-check vs cropland)
# ==============================================================================

cat(strrep("=", 70), "\n")
cat("PART A2 -- area_harvested_ha plausibility (per crop)\n")
cat(strrep("=", 70), "\n\n")

area_flags <- list()

for (crop_name in crop_names) {
  df <- read_panel(crop_name)
  if (is.null(df) || !"area_harvested_ha" %in% names(df)) next
  
  a <- df$area_harvested_ha
  cat(sprintf("[%-8s] min=%.0f  median=%.0f  mean=%.0f  max=%.0f  (ha)\n",
              crop_name, min(a, na.rm = TRUE), median(a, na.rm = TRUE),
              mean(a, na.rm = TRUE), max(a, na.rm = TRUE)))
  
  neg_or_zero <- df[!is.na(a) & a <= 0, c("Country_ISO","Yil","area_harvested_ha")]
  if (nrow(neg_or_zero) > 0)
    cat(sprintf("  [FLAG] %d rows with area_harvested_ha <= 0\n", nrow(neg_or_zero)))
  
  # Cross-check: single-crop harvested area should not routinely exceed
  # the country's total cropland area (cropland_area_1000ha, from Step 5).
  # Some excess is possible (multi-cropping/double-cropping counted
  # separately in FAO data), so this is flagged for review, not treated
  # as a hard error.
  if ("cropland_area_1000ha" %in% names(df)) {
    df$cropland_ha <- df$cropland_area_1000ha * 1000
    exceed <- df[!is.na(df$area_harvested_ha) & !is.na(df$cropland_ha) &
                   df$area_harvested_ha > df$cropland_ha,
                 c("Country_ISO","Yil","area_harvested_ha","cropland_ha")]
    if (nrow(exceed) > 0) {
      exceed$ratio <- round(exceed$area_harvested_ha / exceed$cropland_ha, 2)
      cat(sprintf("  [FLAG] %d rows where this crop's area exceeds total cropland area:\n",
                  nrow(exceed)))
      print(head(exceed[order(-exceed$ratio), ], 10))
      area_flags[[crop_name]] <- cbind(crop = crop_name, exceed)
    } else {
      cat("  [OK] crop area never exceeds total cropland area\n")
    }
  }
  cat("\n")
}
area_flags_df <- dplyr::bind_rows(area_flags)


# ==============================================================================
# PART A3 -- GDP_per_Capita PLAUSIBILITY
# ==============================================================================

cat(strrep("=", 70), "\n")
cat("PART A3 -- GDP_per_Capita plausibility (per crop panel; GDP is the\n")
cat("           same series across crops for a given country-year, so any\n")
cat("           one crop panel is representative -- using wheat)\n")
cat(strrep("=", 70), "\n\n")

df_gdp_check <- read_panel("wheat")

if (!is.null(df_gdp_check) && "GDP_per_Capita" %in% names(df_gdp_check)) {
  g <- df_gdp_check$GDP_per_Capita
  cat(sprintf("GDP_per_Capita: min=%.0f  median=%.0f  mean=%.0f  max=%.0f  (USD)\n",
              min(g, na.rm = TRUE), median(g, na.rm = TRUE),
              mean(g, na.rm = TRUE), max(g, na.rm = TRUE)))
  
  neg_or_zero_gdp <- df_gdp_check[!is.na(g) & g <= 0,
                                  c("Country_ISO","Yil","GDP_per_Capita")]
  if (nrow(neg_or_zero_gdp) > 0) {
    cat(sprintf("[FLAG] %d rows with GDP_per_Capita <= 0\n", nrow(neg_or_zero_gdp)))
  } else {
    cat("[OK] no non-positive GDP_per_Capita values\n")
  }
  
  # Extreme year-over-year jumps: ratio > 5x or < 0.2x vs previous year,
  # within the same country -- possible data error or genuine crisis/
  # currency event, worth a look either way.
  gdp_jumps <- df_gdp_check %>%
    dplyr::arrange(Country_ISO, Yil) %>%
    dplyr::group_by(Country_ISO) %>%
    dplyr::mutate(gdp_ratio = GDP_per_Capita / dplyr::lag(GDP_per_Capita)) %>%
    dplyr::ungroup() %>%
    dplyr::filter(!is.na(gdp_ratio) & (gdp_ratio > 5 | gdp_ratio < 0.2))
  
  cat(sprintf("\n[FLAG] %d country-years with >5x or <0.2x GDP jump vs prior year:\n",
              nrow(gdp_jumps)))
  if (nrow(gdp_jumps) > 0)
    print(gdp_jumps[order(-gdp_jumps$gdp_ratio),
                    c("Country_ISO","Yil","GDP_per_Capita","gdp_ratio")], n = 20)
  
  # Leftover flat/constant runs (3+ consecutive identical values) anywhere
  # in the series -- Step 7 only removes a flat run at the START of a
  # series (WDI backfill artifact); a flat run in the MIDDLE would not be
  # caught by that function and is worth flagging separately.
  flat_runs <- df_gdp_check %>%
    dplyr::arrange(Country_ISO, Yil) %>%
    dplyr::group_by(Country_ISO) %>%
    dplyr::mutate(
      same_as_prev = GDP_per_Capita == dplyr::lag(GDP_per_Capita),
      run_id = cumsum(is.na(same_as_prev) | !same_as_prev)) %>%
    dplyr::group_by(Country_ISO, run_id) %>%
    dplyr::summarise(run_length = dplyr::n(),
                     start_year = min(Yil), end_year = max(Yil),
                     value = dplyr::first(GDP_per_Capita), .groups = "drop") %>%
    dplyr::filter(run_length >= 4)
  
  cat(sprintf("\n[FLAG] %d flat GDP runs of >= 4 consecutive identical years\n",
              nrow(flat_runs)))
  if (nrow(flat_runs) > 0)
    print(flat_runs[order(-flat_runs$run_length), ], n = 20)
  
} else {
  gdp_jumps <- data.frame(); flat_runs <- data.frame()
  cat("[SKIP] wheat panel or GDP_per_Capita column not found\n")
}
cat("\n")



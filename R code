# ==============================================================================
# STEP 6 -- ARIDITY INDEX (AI = PRE_ann / PET_ann) + is_arid -> panelv6
#
# Definition follows UNEP (1997) Aridity Index classification:
#   AI < 0.05 : hyper-arid   | AI < 0.20 : arid
#   AI < 0.50 : semi-arid    | AI < 0.65 : dry sub-humid
# is_arid = 1 if AI < 0.50 (semi-arid and drier) -- the threshold commonly
# used as the risk boundary for reliable rainfed cereal production.
#
# PET data quality is checked BEFORE the index is used anywhere downstream:
#   (a) PET_ann should fall within a physically plausible range (0-3000 mm/yr)
#   (b) count of PET_ann == 0 or NA observations is reported
#   (c) the AI distribution is summarised (and can be plotted) to catch
#       skew or implausible spikes before trusting is_arid in the models
#
# TWO aridity variables are produced here, for two different purposes:
#   AI / is_arid            -- YEAR-VARYING (this country, this year's own
#                              PRE_ann/PET_ann). Reflects short-run wet/dry
#                              conditions, which overlaps heavily with PRE
#                              itself -- appropriate for within-year
#                              robustness checks, but NOT for classifying a
#                              country as structurally arid vs humid.
#   AI_baseline / is_arid_fixed -- TIME-INVARIANT (one fixed value per
#                              country, from the 1990-2000 baseline window,
#                              same fallback rule as the fixed-baseline weighting specification). This answers a
#                              genuinely different question: does the same
#                              temperature shock cause more damage in a
#                              structurally arid country than a structurally
#                              humid one? The fixed-aridity interaction specification (is_arid_fixed x TMX) uses
#                              this fixed version so it is not just
#                              re-measuring the precipitation x TMX interaction under another name.
# ==============================================================================

cat("\n", strrep("=", 60), "\nSTEP 6: Aridity Index + is_arid -> panelv6_*\n",
    strrep("=", 60), "\n\n")

AI_THRESHOLD <- 0.50   # semi-arid boundary, UNEP (1997)

# -- PET sanity check, run once on the pooled panel before per-crop processing --
cat("--- PET / AI sanity check (pooled across crops) ---\n")

pet_check_list <- list()
for (crop_name in names(crop_config)) {
  panelv5_path <- file.path(base_dir, paste0("panelv5_", crop_name, ".xlsx"))
  if (!file.exists(panelv5_path)) next
  df_tmp <- as.data.frame(readxl::read_excel(panelv5_path))
  if (!all(c("PRE_ann","PET_ann") %in% names(df_tmp))) next
  pet_check_list[[crop_name]] <- df_tmp[, c("Country_ISO","Yil","PRE_ann","PET_ann")]
}
pet_pool <- dplyr::bind_rows(pet_check_list) %>% dplyr::distinct()

n_total     <- nrow(pet_pool)
n_pet_zero  <- sum(pet_pool$PET_ann == 0, na.rm = TRUE)
n_pet_na    <- sum(is.na(pet_pool$PET_ann))
n_pet_out   <- sum(!is.na(pet_pool$PET_ann) &
                     (pet_pool$PET_ann < 0 | pet_pool$PET_ann > 3000))

cat(sprintf("  Total pooled country-year rows : %d\n", n_total))
cat(sprintf("  PET_ann == 0                   : %d (%.1f%%)\n",
            n_pet_zero, 100 * n_pet_zero / n_total))
cat(sprintf("  PET_ann == NA                  : %d (%.1f%%)\n",
            n_pet_na, 100 * n_pet_na / n_total))
cat(sprintf("  PET_ann outside [0, 3000] mm/yr: %d (%.1f%%)\n",
            n_pet_out, 100 * n_pet_out / n_total))

pet_pool$AI_check <- ifelse(pet_pool$PET_ann > 0,
                            pet_pool$PRE_ann / pet_pool$PET_ann, NA_real_)
cat("\n  AI (PRE_ann / PET_ann) summary:\n")
print(summary(pet_pool$AI_check))
cat(sprintf("  AI outside [0, 5] (implausible): %d rows\n",
            sum(!is.na(pet_pool$AI_check) &
                  (pet_pool$AI_check < 0 | pet_pool$AI_check > 5))))

cat("\n  [NOTE] If PET_ann == 0/NA rate or AI outlier rate is high (e.g. >10%),\n")
cat("         reconsider is_arid definition (e.g. fall back to PRE_ann < 400mm)\n")
cat("         before using is_arid or its interaction (is_arid x TMX) in models.\n\n")

rm(pet_check_list, pet_pool); gc()

# -- Helper: fixed (time-invariant) baseline AI per country --------------------
# Same baseline-window + fallback logic as the fixed-baseline production/area weights
# (Step 7 below), applied here to PRE_ann/PET_ann instead. Uses ratio of
# baseline-period means (not mean of yearly ratios), which is more robust
# to any single unusually wet/dry year within the baseline window.
compute_fixed_aridity <- function(df) {
  df %>%
    dplyr::group_by(Country_ISO) %>%
    dplyr::group_modify(function(sub, key) {
      in_window <- sub[sub$Yil >= BASELINE_START & sub$Yil <= BASELINE_END, ]
      
      if (nrow(in_window) >= 1) {
        used_years  <- sort(in_window$Yil)
        base_pre    <- mean(in_window$PRE_ann, na.rm = TRUE)
        base_pet    <- mean(in_window$PET_ann, na.rm = TRUE)
        is_fallback <- 0L
      } else {
        sub_sorted    <- sub[order(sub$Yil), ]
        take_n        <- min(BASELINE_LEN, nrow(sub_sorted))
        fallback_rows <- sub_sorted[seq_len(take_n), ]
        used_years    <- sort(fallback_rows$Yil)
        base_pre      <- mean(fallback_rows$PRE_ann, na.rm = TRUE)
        base_pet      <- mean(fallback_rows$PET_ann, na.rm = TRUE)
        is_fallback   <- 1L
      }
      
      ai_baseline <- if (!is.na(base_pet) && base_pet > 0) base_pre / base_pet else NA_real_
      period_label <- if (length(used_years) == 0) NA_character_ else
        paste0(min(used_years), "-", max(used_years))
      
      data.frame(
        AI_baseline                  = ai_baseline,
        is_arid_fixed                = ifelse(is.na(ai_baseline), NA_integer_,
                                              as.integer(ai_baseline < AI_THRESHOLD)),
        aridity_baseline_period_used = period_label,
        aridity_baseline_is_fallback = is_fallback,
        stringsAsFactors = FALSE)
    }) %>%
    dplyr::ungroup()
}

# -- Apply AI + is_arid (year-varying) and AI_baseline + is_arid_fixed ---------
# (time-invariant) to each crop panel ------------------------------------------

for (crop_name in names(crop_config)) {
  panelv5_path <- file.path(base_dir, paste0("panelv5_", crop_name, ".xlsx"))
  panelv6_path <- file.path(base_dir, paste0("panelv6_", crop_name, ".xlsx"))
  cat("---", toupper(crop_name), "---\n")
  if (!file.exists(panelv5_path)) { cat("  [ERROR] panelv5 missing\n\n"); next }
  
  panelv5 <- as.data.frame(readxl::read_excel(panelv5_path))
  if (!all(c("PRE_ann","PET_ann") %in% names(panelv5))) {
    cat("  [ERROR] PRE_ann/PET_ann column missing\n\n"); next
  }
  
  panelv5$irr_ratio <- pmin(panelv5$irr_ratio, 1.0)   # ensure cap at 1
  
  panelv6 <- panelv5 %>%
    dplyr::mutate(
      AI = dplyr::case_when(
        is.na(PET_ann) | PET_ann <= 0 ~ NA_real_,
        TRUE ~ PRE_ann / PET_ann),
      is_arid = dplyr::case_when(
        is.na(AI)        ~ NA_real_,
        AI < AI_THRESHOLD ~ 1,
        TRUE              ~ 0))
  
  fixed_aridity <- compute_fixed_aridity(panelv6[, c("Country_ISO","Yil","PRE_ann","PET_ann")])
  panelv6 <- panelv6 %>%
    dplyr::select(-dplyr::any_of(c("AI_baseline","is_arid_fixed",
                                   "aridity_baseline_period_used",
                                   "aridity_baseline_is_fallback"))) %>%
    dplyr::left_join(fixed_aridity, by = "Country_ISO")
  
  n_fallback_arid <- length(unique(
    panelv6$Country_ISO[panelv6$aridity_baseline_is_fallback == 1]))
  
  writexl::write_xlsx(panelv6, panelv6_path)
  cat("  [SAVED]", basename(panelv6_path),
      "| is_arid=1 (year-varying):", sum(panelv6$is_arid == 1, na.rm = TRUE), "rows",
      "| is_arid_fixed=1 (countries):",
      length(unique(panelv6$Country_ISO[panelv6$is_arid_fixed == 1])),
      "| baseline fallback used for", n_fallback_arid, "countries\n\n")
  rm(panelv5, panelv6, fixed_aridity); gc()
}


# ==============================================================================
# STEP 7 -- GDP PER CAPITA (World Bank WDI) -> panelv7 (final output)
#
# Variable: NY.GDP.PCAP.KD (constant 2015 USD per capita)
# Fallback: PPP-adjusted GDP if constant USD missing
# Interpolation: linear within-country interpolation for remaining gaps
# Also fixes WDI's backfilled early-year constant sequences and removes
# duplicate Country_ISO x Yil rows.
# ==============================================================================


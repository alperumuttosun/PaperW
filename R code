crop_names <- c("wheat","barley","oats","rye","rice","maize","soybean","sorghum")

read_panel <- function(crop_name) {
  f <- file.path(base_dir, paste0("panelv7_", crop_name, ".xlsx"))
  if (!file.exists(f)) return(NULL)
  as.data.frame(readxl::read_excel(f))
}


# ==============================================================================
# 1. PET_ann PLAUSIBILITY, PER CROP
# ==============================================================================

cat(strrep("=", 70), "\n")
cat("1. PET_ann PLAUSIBILITY (per crop)\n")
cat(strrep("=", 70), "\n\n")

pet_summary <- list()

for (crop_name in crop_names) {
  df <- read_panel(crop_name)
  if (is.null(df) || !"PET_ann" %in% names(df)) {
    cat(sprintf("[%s] panelv7 missing or no PET_ann column\n", crop_name)); next
  }
  
  n_total  <- nrow(df)
  n_zero   <- sum(df$PET_ann == 0, na.rm = TRUE)
  n_na     <- sum(is.na(df$PET_ann))
  n_out    <- sum(!is.na(df$PET_ann) & (df$PET_ann < 0 | df$PET_ann > 3000))
  
  cat(sprintf("[%-8s] PET_ann: min=%.1f  mean=%.1f  max=%.1f  | zero=%d (%.1f%%) | NA=%d (%.1f%%) | outside[0,3000]=%d\n",
              crop_name,
              min(df$PET_ann, na.rm = TRUE), mean(df$PET_ann, na.rm = TRUE),
              max(df$PET_ann, na.rm = TRUE),
              n_zero, 100 * n_zero / n_total,
              n_na,   100 * n_na   / n_total,
              n_out))
  
  pet_summary[[crop_name]] <- data.frame(
    crop = crop_name, n_total = n_total,
    pet_min = min(df$PET_ann, na.rm = TRUE),
    pet_mean = mean(df$PET_ann, na.rm = TRUE),
    pet_max = max(df$PET_ann, na.rm = TRUE),
    pet_zero_pct = round(100 * n_zero / n_total, 2),
    pet_na_pct   = round(100 * n_na   / n_total, 2),
    stringsAsFactors = FALSE)
}
cat("\n")


# ==============================================================================
# 2. AI DISTRIBUTION, PER CROP
# ==============================================================================

cat(strrep("=", 70), "\n")
cat("2. AI (= PRE_ann / PET_ann) DISTRIBUTION (per crop)\n")
cat(strrep("=", 70), "\n\n")

ai_summary <- list()

for (crop_name in crop_names) {
  df <- read_panel(crop_name)
  if (is.null(df) || !"AI" %in% names(df)) {
    cat(sprintf("[%s] no AI column\n", crop_name)); next
  }
  
  ai_vals <- df$AI
  cat(sprintf("[%-8s] AI: min=%.3f  P10=%.3f  median=%.3f  mean=%.3f  P90=%.3f  max=%.3f  | NA=%.1f%%\n",
              crop_name,
              min(ai_vals, na.rm = TRUE),
              quantile(ai_vals, 0.10, na.rm = TRUE),
              median(ai_vals, na.rm = TRUE),
              mean(ai_vals, na.rm = TRUE),
              quantile(ai_vals, 0.90, na.rm = TRUE),
              max(ai_vals, na.rm = TRUE),
              100 * mean(is.na(ai_vals))))
  
  # How many rows fall in each UNEP (1997) aridity class
  n_valid <- sum(!is.na(ai_vals))
  cat(sprintf("           hyper-arid(<0.05)=%.1f%% | arid(<0.20)=%.1f%% | semi-arid(<0.50)=%.1f%% | dry-subhumid(<0.65)=%.1f%% | humid(>=0.65)=%.1f%%\n",
              100 * sum(ai_vals < 0.05,                 na.rm = TRUE) / n_valid,
              100 * sum(ai_vals < 0.20,                 na.rm = TRUE) / n_valid,
              100 * sum(ai_vals < 0.50,                 na.rm = TRUE) / n_valid,
              100 * sum(ai_vals < 0.65,                 na.rm = TRUE) / n_valid,
              100 * sum(ai_vals >= 0.65,                na.rm = TRUE) / n_valid))
  
  ai_summary[[crop_name]] <- data.frame(
    crop = crop_name,
    ai_min = min(ai_vals, na.rm = TRUE), ai_median = median(ai_vals, na.rm = TRUE),
    ai_mean = mean(ai_vals, na.rm = TRUE), ai_max = max(ai_vals, na.rm = TRUE),
    pct_semiarid_or_drier = round(100 * sum(ai_vals < 0.50, na.rm = TRUE) / n_valid, 2),
    stringsAsFactors = FALSE)
}
cat("\n")


# ==============================================================================
# 3. is_arid INTERNAL CONSISTENCY CHECK (per crop)
# is_arid should be TRUE if and only if AI < 0.50 (given the panelv6/v7
# formula). Any mismatch here points to a bug in Step 6 itself, not just
# "real-world AI happens to be high everywhere".
# ==============================================================================

cat(strrep("=", 70), "\n")
cat("3. is_arid CONSISTENCY CHECK (is_arid should equal AI < 0.50 exactly)\n")
cat(strrep("=", 70), "\n\n")

consistency_summary <- list()

for (crop_name in crop_names) {
  df <- read_panel(crop_name)
  if (is.null(df) || !all(c("AI","is_arid") %in% names(df))) {
    cat(sprintf("[%s] missing AI or is_arid column\n", crop_name)); next
  }
  
  expected_arid <- as.integer(df$AI < 0.50)
  mismatch <- !is.na(df$AI) & !is.na(df$is_arid) & (expected_arid != df$is_arid)
  n_mismatch <- sum(mismatch, na.rm = TRUE)
  
  cat(sprintf("[%-8s] is_arid=1 count: %d (%.1f%%) | mismatches vs AI<0.50: %d\n",
              crop_name,
              sum(df$is_arid == 1, na.rm = TRUE),
              100 * mean(df$is_arid == 1, na.rm = TRUE),
              n_mismatch))
  
  consistency_summary[[crop_name]] <- data.frame(
    crop = crop_name,
    is_arid_pct = round(100 * mean(df$is_arid == 1, na.rm = TRUE), 2),
    n_mismatch  = n_mismatch,
    stringsAsFactors = FALSE)
}
cat("\n[NOTE] n_mismatch > 0 would mean is_arid was NOT computed consistently\n")
cat("       from the AI values actually stored in the file -- a formula bug.\n")
cat("       n_mismatch = 0 means is_arid is internally consistent, and any\n")
cat("       low arid share simply reflects the AI values themselves, which\n")
cat("       is checked next (Section 4).\n\n")


# ==============================================================================
# 4. COUNTRY-LEVEL MEAN AI FOR KNOWN ARID/SEMI-ARID COUNTRIES
#
# These countries are unambiguously arid or semi-arid on essentially any
# definition. If their mean AI comes out >= 0.50 (i.e. classified as NOT
# arid), that is a strong signal something is still wrong upstream --
# most likely a unit mismatch between PRE_ann and PET_ann, or a residual
# weighting issue from the area-weighting step.
# ==============================================================================

cat(strrep("=", 70), "\n")
cat("4. COUNTRY-LEVEL MEAN AI -- known arid/semi-arid countries (sanity check)\n")
cat(strrep("=", 70), "\n\n")

known_arid_countries <- c(
  SAU = "Saudi Arabia", EGY = "Egypt", ARE = "UAE", QAT = "Qatar",
  KWT = "Kuwait", OMN = "Oman", YEM = "Yemen", LBY = "Libya",
  DZA = "Algeria", TUN = "Tunisia", MRT = "Mauritania", NER = "Niger",
  TCD = "Chad", SDN = "Sudan", NAM = "Namibia", BWA = "Botswana",
  TKM = "Turkmenistan", UZB = "Uzbekistan", KAZ = "Kazakhstan (south)",
  IRQ = "Iraq", JOR = "Jordan", ISR = "Israel"
)

# Use wheat panel as a representative check (most countries present);
# fall back to sorghum for any missing from wheat
df_wheat   <- read_panel("wheat")
df_sorghum <- read_panel("sorghum")

country_ai_rows <- list()
for (iso in names(known_arid_countries)) {
  src <- NULL
  if (!is.null(df_wheat) && iso %in% df_wheat$Country_ISO) src <- df_wheat
  else if (!is.null(df_sorghum) && iso %in% df_sorghum$Country_ISO) src <- df_sorghum
  
  if (is.null(src)) {
    country_ai_rows[[iso]] <- data.frame(
      Country_ISO = iso, name = known_arid_countries[iso],
      mean_AI = NA_real_, mean_PRE_ann = NA_real_, mean_PET_ann = NA_real_,
      is_arid_pct = NA_real_, note = "not in panel", stringsAsFactors = FALSE)
    next
  }
  
  sub <- src[src$Country_ISO == iso, ]
  country_ai_rows[[iso]] <- data.frame(
    Country_ISO   = iso,
    name          = known_arid_countries[iso],
    mean_AI       = round(mean(sub$AI, na.rm = TRUE), 3),
    mean_PRE_ann  = round(mean(sub$PRE_ann, na.rm = TRUE), 1),
    mean_PET_ann  = round(mean(sub$PET_ann, na.rm = TRUE), 1),
    is_arid_pct   = round(100 * mean(sub$is_arid == 1, na.rm = TRUE), 1),
    note          = ifelse(mean(sub$AI, na.rm = TRUE) < 0.50,
                           "OK (classified arid/semi-arid)",
                           "FLAG -- expected arid, AI >= 0.50"),
    stringsAsFactors = FALSE)
}

country_ai_df <- dplyr::bind_rows(country_ai_rows)
print(country_ai_df[, c("Country_ISO","name","mean_AI","mean_PRE_ann",
                        "mean_PET_ann","is_arid_pct","note")], row.names = FALSE)

n_flagged <- sum(grepl("^FLAG", country_ai_df$note))
cat(sprintf("\n[SUMMARY] %d / %d known arid/semi-arid countries are NOT classified\n",
            n_flagged, sum(!is.na(country_ai_df$mean_AI))))
cat("          as arid (AI >= 0.50) -- if this is a large fraction, the AI\n")
cat("          formula, PET units, or weighting likely still has an issue.\n\n")



BASELINE_START <- 1990
BASELINE_END   <- 2000
BASELINE_LEN   <- BASELINE_END - BASELINE_START + 1   # 11

compute_baseline <- function(df) {
  df %>%
    dplyr::group_by(Country_ISO) %>%
    dplyr::group_modify(function(sub, key) {
      in_window <- sub[sub$Yil >= BASELINE_START & sub$Yil <= BASELINE_END, ]
      
      if (nrow(in_window) >= 1) {
        used_years <- sort(in_window$Yil)
        base_prod  <- mean(in_window$production_tonnes, na.rm = TRUE)
        base_area  <- mean(in_window$area_harvested_ha, na.rm = TRUE)
        is_fallback <- 0L
      } else {
        # Fallback: earliest available years for this country (up to 11)
        sub_sorted <- sub[order(sub$Yil), ]
        take_n     <- min(BASELINE_LEN, nrow(sub_sorted))
        fallback_rows <- sub_sorted[seq_len(take_n), ]
        used_years    <- sort(fallback_rows$Yil)
        base_prod     <- mean(fallback_rows$production_tonnes, na.rm = TRUE)
        base_area     <- mean(fallback_rows$area_harvested_ha, na.rm = TRUE)
        is_fallback   <- 1L
      }
      
      period_label <- if (length(used_years) == 0) NA_character_ else
        paste0(min(used_years), "-", max(used_years))
      
      data.frame(
        baseline_production_tonnes = base_prod,
        baseline_area_harvested_ha = base_area,
        baseline_period_used       = period_label,
        baseline_is_fallback       = is_fallback,
        stringsAsFactors = FALSE)
    }) %>%
    dplyr::ungroup()
}

fallback_summary <- list()

for (crop_name in crop_names) {
  panelv7_path <- file.path(base_dir, paste0("panelv7_", crop_name, ".xlsx"))
  df <- read_panel(crop_name)
  if (is.null(df)) { cat(sprintf("[%s] panelv7 missing, skipped\n", crop_name)); next }
  
  baseline_vals <- compute_baseline(df)
  
  df <- df %>%
    dplyr::select(-dplyr::any_of(c("baseline_production_tonnes",
                                   "baseline_area_harvested_ha",
                                   "baseline_period_used",
                                   "baseline_is_fallback"))) %>%
    dplyr::left_join(baseline_vals, by = "Country_ISO")
  
  n_fallback <- length(unique(df$Country_ISO[df$baseline_is_fallback == 1]))
  n_total    <- length(unique(df$Country_ISO))
  cat(sprintf("[%-8s] baseline computed | fallback used for %d / %d countries\n",
              crop_name, n_fallback, n_total))
  
  if (n_fallback > 0) {
    fb_detail <- df %>%
      dplyr::filter(baseline_is_fallback == 1) %>%
      dplyr::distinct(Country_ISO, baseline_period_used) %>%
      dplyr::mutate(crop = crop_name)
    fallback_summary[[crop_name]] <- fb_detail
    print(fb_detail[, c("Country_ISO","baseline_period_used")], row.names = FALSE)
  }
  
  writexl::write_xlsx(df, panelv7_path)
  cat(sprintf("  [SAVED] %s (with baseline columns added)\n\n", basename(panelv7_path)))
}

fallback_df <- dplyr::bind_rows(fallback_summary)


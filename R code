read_panel <- function(crop_name) {                                        # raw panel for one crop
  read_excel(file.path(base_dir, paste0("panelv7_", crop_name, ".xlsx")))
}

prep_panel <- function(crop_name) {                                        # eligibility + fixed n* subsample + drop NAs
  df <- read_panel(crop_name)
  counts <- df %>% count(Country_ISO)                                      # observations per country
  eligible <- counts$Country_ISO[counts$n >= min_obs]                      # countries with enough years
  df %>%
    filter(Country_ISO %in% eligible) %>%
    group_by(Country_ISO) %>%
    slice_sample(n = n_star) %>%                                           # fixed n* observations per country
    ungroup() %>%
    filter(if_all(all_of(c(feats, y_col)), ~ !is.na(.)))                   # drop rows with missing values
}

fit_and_rmse <- function(train_df, test_df) {                              # fit LASSO + XGBoost, return held-out RMSE
  X_tr <- as.matrix(train_df[, feats]); y_tr <- train_df[[y_col]]          # training X / y
  X_te <- as.matrix(test_df[, feats]);  y_te <- test_df[[y_col]]           # held-out target X / y
  m_lasso <- cv.glmnet(X_tr, y_tr, alpha = 1)                              # cross-validated LASSO
  p_lasso <- as.numeric(predict(m_lasso, X_te, s = "lambda.min"))          # LASSO prediction
  m_xgb <- xgboost(x = X_tr, y = y_tr, nrounds = 100, max_depth = 4,
                   learning_rate = 0.1, verbosity = 0)                     # XGBoost fit (new xgboost API)
  p_xgb <- as.numeric(predict(m_xgb, X_te))                                # XGBoost prediction
  c(lasso = sqrt(mean((y_te - p_lasso)^2)),                                # LASSO RMSE
    xgb   = sqrt(mean((y_te - p_xgb)^2)))                                  # XGBoost RMSE
}


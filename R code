# ==============================================================================
# CHECK -- full country AI ranking + humid-country sanity check
#
# The previous check (check_ai_pet_arid.R) only tested 22 pre-selected
# arid/semi-arid countries. This script extends that in two ways:
#   1. Builds a country-level mean AI ranking across ALL countries present
#      in the panel (pooled across crops), so the full list can be
#      eyeballed for anything geographically implausible.
#   2. Tests a complementary set of well-known HUMID/tropical countries
#      (rainforest climates) -- these should show HIGH AI and is_arid = 0
#      almost always. If any of these come out arid, that is a red flag
#      in the opposite direction from the earlier check.
#
# Does not modify any panelv*_ file. Read-only diagnostic.
# ==============================================================================

library(dplyr)
library(readxl)
library(writexl)

base_dir   <- "C:/Users/Alper.Tosun/Desktop/cru130"
crop_names <- c("wheat","barley","oats","rye","rice","maize","soybean","sorghum")

read_panel <- function(crop_name) {
  f <- file.path(base_dir, paste0("panelv7_", crop_name, ".xlsx"))
  if (!file.exists(f)) return(NULL)
  as.data.frame(readxl::read_excel(f))
}


# ==============================================================================
# 1. POOL AI ACROSS ALL CROPS, ONE ROW PER COUNTRY
#
# A country's AI should be nearly identical across crop panels (it only
# depends on national PRE_ann/PET_ann, not on the crop-specific area
# weights), so pooling and averaging across crops is just a way to get
# the widest possible country coverage in one table, not a real
# aggregation across genuinely different values.
# ==============================================================================

cat(strrep("=", 70), "\n")
cat("1. Pooling AI across all 8 crop panels\n")
cat(strrep("=", 70), "\n\n")

all_rows <- list()
for (crop_name in crop_names) {
  df <- read_panel(crop_name)
  if (is.null(df) || !all(c("Country_ISO","AI","is_arid","PRE_ann","PET_ann") %in% names(df))) next
  all_rows[[crop_name]] <- df[, c("Country_ISO","AI","is_arid","PRE_ann","PET_ann")]
}
pooled <- dplyr::bind_rows(all_rows)

country_ai <- pooled %>%
  dplyr::group_by(Country_ISO) %>%
  dplyr::summarise(
    n_obs        = dplyr::n(),
    mean_AI      = round(mean(AI, na.rm = TRUE), 3),
    sd_AI        = round(sd(AI, na.rm = TRUE), 3),
    mean_PRE_ann = round(mean(PRE_ann, na.rm = TRUE), 0),
    mean_PET_ann = round(mean(PET_ann, na.rm = TRUE), 0),
    pct_arid     = round(100 * mean(is_arid == 1, na.rm = TRUE), 1),
    .groups = "drop") %>%
  dplyr::arrange(mean_AI)

cat(sprintf("[OK] %d unique countries pooled across all crop panels\n\n",
            nrow(country_ai)))

cat("--- 15 DRIEST countries (lowest mean AI) ---\n")
print(head(country_ai, 15), n = Inf)

cat("\n--- 15 WETTEST countries (highest mean AI) ---\n")
print(tail(country_ai, 15), n = Inf)


# ==============================================================================

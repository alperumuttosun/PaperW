step9 <- function() {
  library(ggplot2); library(ggpattern)                                     # install.packages("ggpattern") if missing
  s2 <- read_excel(out_file("networkstep2_output.xlsx"))
  # Figure 1: observed modularity (solid) vs null-model-1 mean (hollow), LASSO
  f1 <- s2 %>% filter(metric == "NT_lasso") %>% mutate(crop = factor(crop, levels = names(crop_colors)))
  yr <- max(f1$modularity_real)
  fig1 <- ggplot(f1, aes(x = crop)) +
    geom_segment(aes(xend = crop, y = modularity_null_mean, yend = modularity_real, color = crop), alpha = 0.5, linewidth = 0.6) +
    geom_point(aes(y = modularity_null_mean, color = crop), shape = 21, fill = "white", stroke = 1.4, size = 4) +
    geom_point(aes(y = modularity_real, color = crop, fill = crop), shape = 21, stroke = 1.4, size = 4) +
    scale_color_manual(values = crop_colors, guide = "none") + scale_fill_manual(values = crop_colors, guide = "none") +
    annotate("point", x = 6.3, y = yr + 0.045, shape = 21, fill = "grey50", color = "grey50", stroke = 1.4, size = 4) +
    annotate("text",  x = 6.5, y = yr + 0.045, label = "Observed", hjust = 0, size = 3.6) +
    annotate("point", x = 6.3, y = yr + 0.005, shape = 21, fill = "white", color = "grey50", stroke = 1.4, size = 4) +
    annotate("text",  x = 6.5, y = yr + 0.005, label = "Null (weight-shuffled)", hjust = 0, size = 3.6) +
    coord_cartesian(ylim = c(NA, yr + 0.06)) + labs(x = "Crop", y = "Modularity") +
    theme_minimal(base_size = 12) + theme(panel.grid.minor = element_blank())
  for (ext in c("pdf", "png", "tiff"))
    ggsave(file.path(fig_dir, paste0("fig1_modularity_vs_null.", ext)), fig1, width = 7, height = 4.8, dpi = 300)
  # Figure 2: ARI / NMI vs climate-GDP clusters; LASSO solid, XGBoost striped (same colour)
  f2 <- s2 %>% select(crop, metric, ARI_vs_climate, NMI_vs_climate) %>%
    pivot_longer(c(ARI_vs_climate, NMI_vs_climate), names_to = "stat", values_to = "value") %>%
    mutate(crop = factor(crop, levels = names(crop_colors)),
           stat = recode(stat, ARI_vs_climate = "ARI", NMI_vs_climate = "NMI"),
           model = recode(metric, NT_lasso = "LASSO", NT_xgb = "XGBoost"))
  fig2 <- ggplot(f2, aes(x = crop, y = value, fill = crop, pattern = model)) +
    geom_col_pattern(position = position_dodge(width = 0.8), width = 0.7, color = "black", pattern_fill = "white",
                     pattern_density = 0.35, pattern_spacing = 0.02, pattern_angle = 45, pattern_color = NA) +
    scale_fill_manual(values = crop_colors, guide = "none") +
    scale_pattern_manual(values = c(LASSO = "none", XGBoost = "stripe"), name = "Model") +
    facet_wrap(~stat) + labs(x = "Crop", y = "Agreement with climate/GDP clusters") +
    theme_minimal(base_size = 12) +
    theme(axis.text.x = element_text(angle = 45, hjust = 1), legend.position = "top",
          legend.spacing.x = unit(1.2, "cm"), legend.box.spacing = unit(0.5, "cm"), legend.title = element_blank())
  for (ext in c("pdf", "png", "tiff"))
    ggsave(file.path(fig_dir, paste0("fig2_ari_nmi_climate.", ext)), fig2, width = 8, height = 5, dpi = 300)
  cat("Figures saved to:", fig_dir, "\n")
}


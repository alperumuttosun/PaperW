# ==============================================================================
# STEP 3 -- EXTRA COUNTRIES (IRN, EGY, NGA, SDN) -> panelv3
#
# These countries were missing from panelv2 due to GADM boundary issues.
# Fix: extract climate using GADM cache (or rnaturalearth for Egypt),
# join FAO data from extra_countries_xls. Result appended to panelv2 -> panelv3.
# ==============================================================================

library(terra); library(geodata)
library(dplyr); library(readxl); library(writexl)
library(data.table); library(tidyr); library(zoo)

EXTRA_COUNTRIES <- c("IRN", "EGY", "NGA", "SDN")

cat("\n", strrep("=", 60), "\n")
cat("STEP 3: Climate extraction for extra countries\n")
cat(strrep("=", 60), "\n\n")

cat("[*] Loading CRU files...\n")
cru_list <- list()
for (v in names(cru_var_info)) {
  nc_path <- file.path(climate_dir, cru_var_info[[v]]$nc)
  if (!file.exists(nc_path)) { cat("  [!] Missing:", v, "\n"); next }
  cru_list[[v]] <- terra::rast(nc_path)
  cat("  [OK]", v, "\n")
}

# CROPGRIDS rasters already loaded once in Step 1 (cropgrids_rast) -- reused
# here rather than reloaded, same country-outer logic as Step 1: CRU is
# cropped/masked once per country, then each crop's CROPGRIDS weight is
# resampled against that shared CRU stack.
extra_climate_by_crop <- setNames(vector("list", length(crop_config)), names(crop_config))
for (crop_name in names(crop_config)) extra_climate_by_crop[[crop_name]] <- list()

for (iso in EXTRA_COUNTRIES) {
  cat("\n>>", iso)
  t0 <- Sys.time()
  
  gadm_cache <- file.path(base_dir, "gadm",
                          paste0("gadm_41_", iso, "_0_pk.rds"))
  if (file.exists(gadm_cache)) {
    boundary <- readRDS(gadm_cache); cat(" [cache]")
  } else {
    boundary <- tryCatch(
      geodata::gadm(country = iso, level = 0, path = base_dir),
      error = function(e) { cat(" [GADM error]"); NULL })
  }
  if (is.null(boundary)) next
  
  # Crop + mask CRU ONCE for this country, reused across all 8 crops
  cru_country <- list()
  for (v in names(cru_list)) {
    cru_country[[v]] <- terra::mask(
      terra::crop(cru_list[[v]], terra::ext(boundary)), boundary)
  }
  
  for (crop_name in names(crop_config)) {
    cg_global <- cropgrids_rast[[crop_name]]
    cg_crop   <- terra::crop(cg_global, terra::ext(boundary))
    
    country_tbl <- data.frame(Country_ISO = iso,
                              Yil = year_month_df$Yil, Ay = year_month_df$Ay)
    
    ref_r    <- cru_country[[1]][[1]]
    cg_res   <- terra::resample(cg_crop, ref_r, method = "sum")
    cg_m     <- terra::mask(cg_res, boundary)
    w_base   <- as.vector(terra::values(cg_m))
    has_area <- !is.na(sum(w_base, na.rm = TRUE)) &&
      sum(w_base, na.rm = TRUE) > 0
    
    for (v in names(cru_country)) {
      v_mat <- terra::values(cru_country[[v]])
      
      if (has_area) {
        cg_res2 <- terra::resample(cg_crop, cru_country[[v]][[1]], method = "sum")
        w  <- as.vector(terra::values(terra::mask(cg_res2, boundary)))
        ws <- sum(w, na.rm = TRUE)
        monthly <- if (!is.na(ws) && ws > 0)
          colSums(v_mat * w, na.rm = TRUE) / ws
        else
          colMeans(v_mat, na.rm = TRUE)
      } else {
        monthly <- colMeans(v_mat, na.rm = TRUE)
      }
      
      if (cru_var_info[[v]]$scale) monthly <- check_scale(monthly, v)
      country_tbl[[toupper(v)]] <- monthly
    }
    
    extra_climate_by_crop[[crop_name]][[iso]] <- country_tbl
  }
  cat("  [", round(difftime(Sys.time(), t0, units = "secs"), 1), "s]")
}

